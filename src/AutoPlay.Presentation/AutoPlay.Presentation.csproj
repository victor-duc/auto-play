<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Presentation logic (MVVM view models) of the WPF user interface, without any dependency on WPF so
    that it can be unit tested on any OS. The views and the services that open windows live in the App.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoPlay.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPlay.Application\AutoPlay.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
