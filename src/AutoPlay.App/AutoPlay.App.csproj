<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AutoPlay.App</RootNamespace>
    <AssemblyName>AutoPlay</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: the Fluent theme (ThemeMode) is flagged as experimental by the WPF team. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPlay.Application\AutoPlay.Application.csproj" />
    <ProjectReference Include="..\AutoPlay.Presentation\AutoPlay.Presentation.csproj" />
    <ProjectReference Include="..\AutoPlay.Adapters.Persistence\AutoPlay.Adapters.Persistence.csproj" />
    <ProjectReference Include="..\AutoPlay.Adapters.Vision\AutoPlay.Adapters.Vision.csproj" />
    <ProjectReference Include="..\AutoPlay.Adapters.Windows\AutoPlay.Adapters.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>

</Project>
