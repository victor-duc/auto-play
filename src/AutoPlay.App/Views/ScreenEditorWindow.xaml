<Window x:Class="AutoPlay.App.Views.ScreenEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoPlay.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ScreenEditorViewModel}"
        Title="{Binding Title}" Width="1200" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <SolidColorBrush x:Key="LocationBrush" Color="#FF00BFFF" />
        <SolidColorBrush x:Key="SelectedLocationBrush" Color="#FFFF8C00" />
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#22000000" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Screen name" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="ScreenNameBox" Width="220" Margin="0,0,20,0" VerticalContentAlignment="Center"
                             Text="{Binding ScreenName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Delay before click (ms)" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="60" VerticalContentAlignment="Center" ToolTip="Minimum"
                             Text="{Binding DelayMinMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                    <TextBox Width="60" Margin="0,0,20,0" VerticalContentAlignment="Center" ToolTip="Maximum"
                             Text="{Binding DelayMaxMs, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" ToolTip="Save (Enter)" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" ToolTip="Cancel (Esc)" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="Drag on the capture to draw a location · Click to create a default-size location · Drag a location to move it, or a corner to resize it · Shift+click inside the selected location to set its click point · Delete removes the selected location" />
                <TextBlock Margin="0,6,0,0" Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Locations panel -->
        <Border DockPanel.Dock="Right" Width="330" Padding="12" BorderBrush="#22000000" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="{Binding Locations.Count, StringFormat='Locations ({0})'}" />
                <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Foreground="Gray" />
                    <TextBlock Grid.Column="1" Text="Threshold" Foreground="Gray" Margin="6,0,0,0" />
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                           Text="Threshold: minimum similarity, from 0 to 1, required to click the location. Leave empty to use the profile default (0.8)." />
                <ListBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <!-- Typing in a field of a row selects that location. -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="IsSelected" Value="True" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LocationViewModel}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Location name" />
                                <TextBox Grid.Column="1" Margin="6,0,6,0" ToolTip="Match threshold (empty = profile default)"
                                         Text="{Binding MatchThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="✕" MinWidth="0" Margin="0" Padding="0" ToolTip="Delete this location"
                                        Command="{Binding DataContext.DeleteLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Capture and locations. Inside the Viewbox, one unit is one capture pixel. -->
        <Grid Background="#FF2B2B2B" ClipToBounds="True">
            <Viewbox x:Name="CaptureViewbox" Margin="16" Stretch="Uniform" StretchDirection="DownOnly" SizeChanged="OnViewboxSizeChanged">
                <Grid x:Name="Surface" Width="{Binding PixelWidth}" Height="{Binding PixelHeight}">
                    <Image Source="{Binding CaptureBitmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

                    <ItemsControl ItemsSource="{Binding Locations}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LocationViewModel}">
                                <Canvas Width="{Binding Width}" Height="{Binding Height}">
                                    <Rectangle x:Name="Frame" Width="{Binding Width}" Height="{Binding Height}"
                                               Stroke="{StaticResource LocationBrush}" Fill="#2600BFFF"
                                               StrokeThickness="{Binding DataContext.StrokeThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <Border x:Name="Label" Background="#CC00BFFF" Padding="4,1">
                                        <Border.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ScaleY="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Border.LayoutTransform>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="Black" />
                                    </Border>
                                    <Path Canvas.Left="{Binding ClickOffsetX}" Canvas.Top="{Binding ClickOffsetY}"
                                          Data="M -7,0 L 7,0 M 0,-7 L 0,7" Stroke="Red" StrokeThickness="2">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ScaleY="{Binding DataContext.MarkerScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Frame" Property="Stroke" Value="{StaticResource SelectedLocationBrush}" />
                                        <Setter TargetName="Frame" Property="Fill" Value="#33FF8C00" />
                                        <Setter TargetName="Label" Property="Background" Value="#CCFF8C00" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Receives all mouse input; hit-testing is done in code against the location rectangles. -->
                    <Canvas x:Name="InputLayer" Background="Transparent" Focusable="True" Cursor="Cross"
                            MouseLeftButtonDown="OnInputMouseLeftButtonDown"
                            MouseMove="OnInputMouseMove"
                            MouseLeftButtonUp="OnInputMouseLeftButtonUp"
                            LostMouseCapture="OnInputLostMouseCapture">
                        <Rectangle x:Name="DraftRectangle" Visibility="Collapsed" Stroke="White" Fill="#33FFFFFF"
                                   StrokeDashArray="4 2" StrokeThickness="{Binding StrokeThickness}" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>
