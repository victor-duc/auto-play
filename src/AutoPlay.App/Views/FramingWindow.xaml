<Window x:Class="AutoPlay.App.Views.FramingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPlay — Frame the target area"
        Width="800" Height="600" MinWidth="160" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#FF1E90FF" BorderThickness="2" Background="#4D1E90FF" MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,12" CornerRadius="6" Background="#E6FFFFFF">
            <StackPanel>
                <TextBlock x:Name="SizeText" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="InstructionsText" Margin="0,6,0,12" MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ConfirmButton" IsDefault="True" Click="OnConfirmClick" />
                    <Button Content="Cancel" IsCancel="True" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
