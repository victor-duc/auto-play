<Window x:Class="AutoPlay.App.Views.SequenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoPlay.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SequenceEditorViewModel}"
        Title="{Binding Title}" Width="1100" Height="720" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="70" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#22000000" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Sequence name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Width="240" Margin="0,0,20,0" VerticalContentAlignment="Center"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Number of times the steps are executed; 0 = until stopped" />
                    <TextBlock Text="time(s) — 0 = until stopped" Foreground="Gray" Style="{StaticResource FieldLabel}" Margin="6,0,20,0" />
                    <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" ToolTip="Save (Enter)" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" ToolTip="Cancel (Esc)" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" />
            </StackPanel>
        </Border>

        <!-- Add a step -->
        <Border DockPanel.Dock="Right" Width="320" Padding="12" BorderBrush="#22000000" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Add a step" />
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Screen" Foreground="Gray" />
                <ComboBox x:Name="ScreenComboBox" DockPanel.Dock="Top" ItemsSource="{Binding ScreenChoices}" SelectedItem="{Binding SelectedScreenChoice}"
                          DisplayMemberPath="Name" IsEnabled="{Binding HasScreens}" />
                <TextBlock DockPanel.Dock="Top" Margin="0,8,0,4" Text="Location" Foreground="Gray" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button HorizontalAlignment="Left" Margin="0" Content="Add step" Command="{Binding AddStepCommand}"
                            ToolTip="Insert the location after the selected step (double-click a location)" />
                    <TextBlock Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="The step is inserted after the selected step, or at the end if no step is selected." />
                    <TextBlock Margin="0,6,0,0" Foreground="Firebrick" TextWrapping="Wrap"
                               Text="This profile has no screen yet: record a screen first."
                               Visibility="{Binding HasScreens, Converter={StaticResource InverseBooleanToVisibility}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SelectedScreenChoice.Locations}" SelectedItem="{Binding SelectedLocationChoice}"
                         MouseDoubleClick="OnLocationDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LocationChoice}">
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Border Width="72" Height="40" Margin="0,0,8,0" Background="#11000000">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" />
                                </Border>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Steps -->
        <DockPanel Margin="12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"
                           Text="{Binding Steps.Count, StringFormat='Steps ({0})'}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Move up" Command="{Binding MoveUpCommand}" ToolTip="Alt+Up" />
                    <Button Content="Move down" Command="{Binding MoveDownCommand}" ToolTip="Alt+Down" />
                    <Button Content="Duplicate" Command="{Binding DuplicateStepCommand}" ToolTip="Ctrl+D" />
                    <Button Content="Delete" Command="{Binding DeleteStepCommand}" ToolTip="Delete" Margin="0" />
                </StackPanel>
            </DockPanel>

            <!-- Settings of the selected step -->
            <GroupBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" DataContext="{Binding SelectedStep}"
                      Header="{Binding Number, StringFormat='Step {0} settings', FallbackValue='Step settings'}"
                      IsEnabled="{Binding DataContext.SelectedStep, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NotNullToBoolean}}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <CheckBox Content="Custom delay before click" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding OverrideDelay}" />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding DelayMinMs, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding OverrideDelay}" ToolTip="Minimum (ms)" />
                        <TextBlock Text="to" Margin="6,0" VerticalAlignment="Center" />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding DelayMaxMs, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding OverrideDelay}" ToolTip="Maximum (ms)" />
                        <TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel>
                        <CheckBox Content="Verify the location before clicking" VerticalAlignment="Center" Margin="0,0,24,0" IsChecked="{Binding Verify}" />
                        <CheckBox Content="Custom timeout" VerticalAlignment="Center" Margin="0,0,12,0"
                                  IsChecked="{Binding OverrideTimeout}" IsEnabled="{Binding Verify}" />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Maximum time to wait for the location to appear (ms)">
                            <TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="Verify" />
                                    <Binding Path="OverrideTimeout" />
                                </MultiBinding>
                            </TextBox.IsEnabled>
                        </TextBox>
                        <TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <ListBox x:Name="StepsList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StepViewModel}">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                            <Border Grid.Column="1" Width="72" Height="40" Margin="0,0,10,0" Background="#11000000">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="StepTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="StepTitle" Property="Foreground" Value="Firebrick" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
