<Window x:Class="AutoPlay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoPlay.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AutoPlay" Width="900" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Profiles" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Margin="0" Content="Add" Command="{Binding CreateProfileCommand}" IsDefault="True" />
                    <TextBox Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name of the new profile, e.g. Hero Wars" />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Content="Delete profile" Command="{Binding DeleteProfileCommand}" />
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
            </DockPanel>

            <!-- Screens and sequences of the selected profile -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Screens" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Record screen" IsEnabled="False" ToolTip="Coming next: screen recording." />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Screens}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Foreground="Gray" Text="{Binding Locations.Count, Mode=OneWay, StringFormat='({0} locations)'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Sequences" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="New sequence" IsEnabled="False" ToolTip="Coming next: sequence editor." />
                        <Button Content="Run" IsEnabled="False" ToolTip="Coming next: sequence execution." />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sequences}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Foreground="Gray" Text="{Binding Steps.Count, Mode=OneWay, StringFormat='({0} steps)'}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
