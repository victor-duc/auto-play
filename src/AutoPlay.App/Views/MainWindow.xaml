<Window x:Class="AutoPlay.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoPlay.Presentation.ViewModels;assembly=AutoPlay.Presentation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="AutoPlay" Width="1000" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Export profile…" Command="{Binding ExportProfileCommand}"
                          ToolTip="Save the selected profile (screens, images, sequences) as a .zip file, for backup or sharing" />
                <Separator />
                <MenuItem Header="_Settings…" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolderCommand}" />
                <MenuItem Header="Open _logs folder" Command="{Binding OpenLogsFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Profiles" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Margin="0" Content="Add" Command="{Binding CreateProfileCommand}" IsDefault="True" />
                    <TextBox Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name of the new profile, e.g. Hero Wars" />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Content="Delete profile" Command="{Binding DeleteProfileCommand}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyStateText}"
                           Visibility="{Binding Profiles.Count, Converter={StaticResource EmptyToVisible}}"
                           Text="Welcome! Create your first profile: type the name of the game or application below (for example Hero Wars) and click Add. A profile groups its screens and sequences." />
                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
            </DockPanel>

            <!-- Screens and sequences of the selected profile -->
            <Grid Grid.Column="2" IsEnabled="{Binding SelectedProfile, Converter={StaticResource NotNullToBoolean}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Screens" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Record screen" Command="{Binding RecordScreenCommand}"
                                ToolTip="Frame the target area, capture it and define its click locations." />
                        <Button Content="Edit" Command="{Binding EditScreenCommand}" ToolTip="Edit the locations of the selected screen (double-click)." />
                        <Button Content="Re-capture" Command="{Binding RecaptureScreenCommand}"
                                ToolTip="Capture the selected screen again (e.g. after a game update) and re-position its locations automatically." />
                        <Button Content="Delete" Command="{Binding DeleteScreenCommand}" />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8" CornerRadius="4" Background="{StaticResource PanelBrush}"
                            Visibility="{Binding HasPendingCaptures, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding PendingCaptures.Count, StringFormat='Pending captures ({0})'}"
                                       ToolTip="Screens captured with the quick capture shortcut, to annotate as screens." />
                            <ItemsControl ItemsSource="{Binding PendingCaptures}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Discard"
                                                    Command="{Binding DataContext.DiscardCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Content="Annotate…"
                                                    Command="{Binding DataContext.AnnotateCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Draw the click locations on this capture and save it as a screen." />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding CapturedAt.LocalDateTime, StringFormat='Captured on {0:g}'}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding Screens.Count, Converter={StaticResource EmptyToVisible}}"
                               Text="No screen yet. Display the game, then click Record screen: frame the game area, capture it and draw the buttons to click. While playing, you can also press the quick capture shortcut (see File > Settings) and annotate the captures here later." />
                    <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditScreenCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="96" Height="54" Margin="0,0,10,0" Background="{StaticResource ThumbnailBrush}">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource RawImageToBitmap}}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LocationsText}" Foreground="{StaticResource HintBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Padding="20,6"
                                Content="▶  Run" Command="{Binding RunSequenceCommand}"
                                ToolTip="Frame the target area and run the selected sequence. F12 (or Esc) stops it; moving the mouse pauses it." />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Sequences" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource EmptyStateText}"
                               Visibility="{Binding Sequences.Count, Converter={StaticResource EmptyToVisible}}"
                               Text="No sequence yet. Once your screens are recorded, click New sequence to chain their locations, then select it and click Run." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="New sequence" Command="{Binding NewSequenceCommand}" />
                        <Button Content="Edit" Command="{Binding EditSequenceCommand}" ToolTip="Edit the selected sequence (double-click)." />
                        <Button Content="Duplicate" Command="{Binding DuplicateSequenceCommand}" />
                        <Button Content="Delete" Command="{Binding DeleteSequenceCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sequences}" SelectedItem="{Binding SelectedSequence}" HorizontalContentAlignment="Stretch">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditSequenceCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Foreground="{StaticResource HintBrush}">
                                            <Run Text="{Binding Details, Mode=OneWay}" />
                                            <Run Text="{Binding ScheduleText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border x:Name="LastRunBadge" Grid.Column="1" Margin="12,0,0,0" Padding="8,2" CornerRadius="4"
                                            VerticalAlignment="Center" ToolTip="{Binding LastRunDetails}">
                                        <TextBlock x:Name="LastRunLabel" Text="{Binding LastRunText}" Foreground="{StaticResource HintBrush}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding LastRunSucceeded}" Value="True">
                                        <Setter TargetName="LastRunBadge" Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                        <Setter TargetName="LastRunLabel" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastRunFailed}" Value="True">
                                        <Setter TargetName="LastRunBadge" Property="Background" Value="{StaticResource ErrorTintBrush}" />
                                        <Setter TargetName="LastRunLabel" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
