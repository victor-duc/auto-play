<Application x:Class="AutoPlay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoPlay.App.Converters"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!--
        ThemeMode enables the Fluent theme of WPF (light or dark, following Windows by default; changed from the
        settings). Implicit styles below are based on the Fluent ones, and colors are semi-transparent so that
        they suit both the light and the dark theme.
    -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:NotNullToBooleanConverter x:Key="NotNullToBoolean" />
        <converters:AllTrueConverter x:Key="AllTrue" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <converters:RawImageToBitmapConverter x:Key="RawImageToBitmap" />
        <converters:CountToVisibilityConverter x:Key="EmptyToVisible" />

        <!-- Theme-neutral brushes -->
        <SolidColorBrush x:Key="DividerBrush" Color="#40808080" />
        <SolidColorBrush x:Key="PanelBrush" Color="#14808080" />
        <SolidColorBrush x:Key="ThumbnailBrush" Color="#1F808080" />
        <SolidColorBrush x:Key="HintBrush" Color="#FF8A8A8A" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFE5484D" />
        <SolidColorBrush x:Key="InfoBrush" Color="#FF3E8ED0" />
        <SolidColorBrush x:Key="SuccessTintBrush" Color="#3330A46C" />
        <SolidColorBrush x:Key="ErrorTintBrush" Color="#33E5484D" />

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <!-- Main action of a screen (e.g. Run). -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="20,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Shown in place of an empty list: a short explanation of what to do. -->
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Application.Resources>
</Application>
