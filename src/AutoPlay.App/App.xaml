<Application x:Class="AutoPlay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoPlay.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <converters:NotNullToBooleanConverter x:Key="NotNullToBoolean" />
        <converters:AllTrueConverter x:Key="AllTrue" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Resources>
</Application>
